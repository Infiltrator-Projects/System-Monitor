# Linux System Monitor generated-reference configuration.
PROJECT_NAME           = "Linux System Monitor"
PROJECT_NUMBER         =
PROJECT_BRIEF          = "Single-process native C/GTK Linux system manager"
OUTPUT_DIRECTORY       = build/docs
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English
OPTIMIZE_OUTPUT_FOR_C  = YES
MARKDOWN_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = README.md

INPUT                  = README.md src
RECURSIVE              = YES
FILE_PATTERNS           = *.h *.c *.md
EXCLUDE                 = src/pci_names_data.c
EXCLUDE_PATTERNS        = */build/* */tests/compat/*

EXTRACT_ALL             = NO
EXTRACT_PRIVATE         = NO
EXTRACT_STATIC          = NO
HIDE_UNDOC_MEMBERS      = YES
HIDE_UNDOC_CLASSES      = NO
JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = YES
INHERIT_DOCS            = YES

SOURCE_BROWSER          = YES
INLINE_SOURCES          = YES
STRIP_CODE_COMMENTS     = NO
REFERENCED_BY_RELATION  = YES
REFERENCES_RELATION     = YES

GENERATE_HTML           = YES
HTML_OUTPUT             = html
GENERATE_TREEVIEW       = YES
FULL_SIDEBAR            = YES
GENERATE_LATEX          = NO
GENERATE_MAN            = NO
GENERATE_XML            = NO

HAVE_DOT                = NO
CLASS_DIAGRAMS          = NO
CALL_GRAPH              = NO
CALLER_GRAPH            = NO

QUIET                   = YES
WARNINGS                = YES
WARN_IF_UNDOCUMENTED    = YES
WARN_IF_DOC_ERROR       = YES
WARN_NO_PARAMDOC        = YES
WARN_AS_ERROR           = YES
